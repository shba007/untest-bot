{
  "name": "untest-bot",
  "version": "0.0.0",
  "description": "Untest Automation Bot",
  "repository": "shba007/untest-bot",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "volta": {
    "node": "22.13.1"
  },
  "engines": {
    "node": "^20.15.0 || ^22.11.0"
  },
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev": "vitest dev",
    "lint": "eslint . --fix",
    "format": "prettier .  --write",
    "build": "unbuild",
    "prepack": "pnpm build",
    "play": "jiti playground/cli",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "tsc --noEmit --skipLibCheck",
    "untest": "jiti ./src/cli.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@notionhq/client": "^2.2.15",
    "@prisma/client": "^5.21.1",
    "confbox": "^0.1.8",
    "consola": "^3.2.3",
    "destr": "^2.0.3",
    "dotenv": "^16.4.5",
    "jspdf": "^2.5.2",
    "pathe": "^1.1.2",
    "prisma": "^5.21.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^22.8.1",
    "@vitest/coverage-v8": "^2.1.3",
    "automd": "^0.3.12",
    "changelogen": "^0.5.7",
    "eslint": "^9.13.0",
    "eslint-config-unjs": "^0.4.1",
    "jiti": "^2.3.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "unbuild": "^3.0.0-rc.7",
    "vitest": "^2.1.3"
  }
}